diff --git a/src/tdflowmcp/pipeline.py b/src/tdflowmcp/pipeline.py
new file mode 100644
index 0000000..b71c698
--- /dev/null
+++ b/src/tdflowmcp/pipeline.py
@@ -0,0 +1,101 @@
+"""Main-thread continuation (owner decision B6, bounded experiment). Pure Python, no `td`.
+
+The audit-worker baseline orchestrates each call on an HTTP handler thread: plan (main) → intent (worker)
+→ execute (main) → outcome (worker). In TouchDesigner every cross-thread step costs about one frame,
+because a thread that finished waiting can resume only when TD releases the GIL.
+
+The continuation keeps the same guarantees with fewer handoffs. The plan step on the main thread
+*submits* the intent (never waits). ``OnFrame`` runs the execute step once that intent is confirmed
+durable, then *submits* the outcome. The handler thread only waits for the result and for the outcome
+to be durable.
+
+- ``Continuations``: futures with a callback, polled on the owner (main) thread within a time budget.
+- ``CallBox``: the handler thread's view of one call. ``start`` (main) and ``cancel`` (handler, on
+  timeout) race under a lock, so a cancelled call can never start executing afterwards.
+"""
+from __future__ import annotations
+
+import threading
+import time
+from typing import Any, Callable, List, Optional, Tuple
+
+PENDING, RUNNING, CANCELLED, DONE = "pending", "running", "cancelled", "done"
+
+
+class CallBox:
+    __slots__ = ("_lock", "_ev", "state", "value", "intent")
+
+    def __init__(self):
+        self._lock = threading.Lock()
+        self._ev = threading.Event()
+        self.state = PENDING
+        self.value: Any = None
+        self.intent = None                   # the intent Future (for a cancelled call's abort record)
+
+    def start(self) -> bool:
+        """Main thread, right before executing. False if the handler already gave up (nothing runs)."""
+        with self._lock:
+            if self.state != PENDING:
+                return False
+            self.state = RUNNING
+            return True
+
+    def cancel(self) -> bool:
+        """Handler thread, on timeout. True: the call never started and never will."""
+        with self._lock:
+            if self.state != PENDING:
+                return False
+            self.state = CANCELLED
+            self._ev.set()
+            return True
+
+    def finish(self, value):
+        with self._lock:
+            self.value = value
+            self.state = DONE
+            self._ev.set()
+
+    def wait(self, timeout: float) -> bool:
+        return self._ev.wait(timeout)
+
+
+class Continuations:
+    """``add`` from the main thread (inside a plan step); ``poll`` only on the owner thread (OnFrame)."""
+
+    def __init__(self, budget_s: float = 0.004, max_age_s: float = 30.0, clock=time.monotonic):
+        self._lock = threading.Lock()
+        self._items: List[Tuple[Any, Callable[[], None], float]] = []
+        self.budget_s, self.max_age_s, self.clock = budget_s, max_age_s, clock
+        self.owner: Optional[int] = None
+        self.stats = {"run": 0, "expired": 0, "errors": 0}
+
+    def add(self, fut, fn: Callable[[], None]):
+        with self._lock:
+            self._items.append((fut, fn, self.clock()))
+
+    def pending(self) -> int:
+        return len(self._items)
+
+    def poll(self) -> int:
+        """Run callbacks whose futures are done, oldest first, within the time budget."""
+        if self.owner is not None and threading.get_ident() != self.owner:
+            raise RuntimeError("continuations run only on the owner (main) thread")
+        end, n, now = time.perf_counter() + self.budget_s, 0, self.clock()
+        with self._lock:
+            ready = [it for it in self._items if it[0].done()]
+            stale = [it for it in self._items if not it[0].done() and now - it[2] > self.max_age_s]
+            keep = [it for it in self._items if it not in ready and it not in stale]
+            self._items = keep
+        self.stats["expired"] += len(stale)          # their handlers timed out and cancelled them
+        for i, (fut, fn, _) in enumerate(ready):
+            if time.perf_counter() >= end:
+                with self._lock:                     # over budget: the rest waits for the next frame
+                    self._items[:0] = ready[i:]
+                break
+            try:
+                fn()
+            except Exception:                        # a callback must never break the frame
+                self.stats["errors"] += 1
+            self.stats["run"] += 1
+            n += 1
+        return n
