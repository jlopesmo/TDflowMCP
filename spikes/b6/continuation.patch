+"""B6 main-thread continuation: same guarantees as the worker baseline, with an owner thread playing
+TouchDesigner's main thread (runs queued main steps and polls continuations once per simulated frame)."""
+import os
+import queue
+import shutil
+import tempfile
+import threading
+import time
+import unittest
+
+from tdflowmcp.auditworker import AuditWorker, StoreProxy
+from tdflowmcp.engine import Engine, MainNotRun, ToolFailure
+from tdflowmcp.identity import Identity
+from tdflowmcp.pipeline import CallBox, Continuations
+from tdflowmcp.policy import Policy
+from tdflowmcp.store import AuditUnavailable
+from tdflowmcp.tools import core_registry
+from tests.unit.test_protocol_engine import ALL, FakeAdapter
+
+SET = ("tdflow_set_parameters", {"path": "/project1/fx/a", "values": {"x": 1}})
+
+
+class Owner(threading.Thread):
+    """Main-thread stand-in: each 'frame' first polls continuations, then runs queued main steps."""
+
+    def __init__(self, cont, frame_s=0.016):
+        super().__init__(daemon=True)
+        self.cont, self.frame_s = cont, frame_s
+        self.jobs: "queue.Queue" = queue.Queue()
+        self.stop_ev, self.paused = threading.Event(), threading.Event()
+        self.step_ms = []
+        self.on_frame = []
+
+    def main(self, fn):                           # handler side of call_main
+        box, ev = {}, threading.Event()
+        self.jobs.put((fn, box, ev))
+        if not ev.wait(5):
+            raise MainNotRun("TDFLOW_TIMEOUT")
+        if "e" in box:
+            raise box["e"]
+        return box["r"]
+
+    def run(self):
+        self.cont.owner = threading.get_ident()
+        while not self.stop_ev.is_set():
+            time.sleep(self.frame_s)
+            if self.paused.is_set():
+                continue
+            for f in self.on_frame:
+                f()
+            t0 = time.perf_counter()
+            self.cont.poll()
+            while True:
+                try:
+                    fn, box, ev = self.jobs.get_nowait()
+                except queue.Empty:
+                    break
+                try:
+                    box["r"] = fn()
+                except BaseException as e:
+                    box["e"] = e
+                ev.set()
+            self.step_ms.append((time.perf_counter() - t0) * 1000)
+
+
+class Base(unittest.TestCase):
+    def setUp(self):
+        self.dir = tempfile.mkdtemp(prefix="tdflow-cont-")
+        self.w = AuditWorker(os.path.join(self.dir, "d"), owner_ident=-1).start()
+        self.assertTrue(self.w.ready.wait(5))
+        self.store = StoreProxy(self.w)
+        self.idn = Identity(self.store)
+        _, tok = self.idn.create_agent("A", "builder", ["/project1/fx/**"])
+        self.tid = self.idn.authenticate(tok)
+        self.cont = Continuations()
+        self.owner = Owner(self.cont)
+        self.owner.start()
+        time.sleep(0.05)
+        self.w.owner_ident = self.owner.ident            # the 'main thread' may never wait for the worker
+        self.ad = FakeAdapter()
+        self.susp, self.gate = [False], [True]
+        self.eng = Engine(self.store, self.idn, Policy("/project1"), core_registry(), self.ad, ALL,
+                          lambda: self.susp[0], main=self.owner.main, continuation=self.cont,
+                          exec_gate=lambda: self.gate[0], wait_s=2.0)
+
+    def tearDown(self):
+        self.owner.stop_ev.set()
+        self.owner.join(2)
+        self.w.owner_ident = -1
+        if self.w.available:
+            self.w.close().result(5)
+        shutil.rmtree(self.dir, ignore_errors=True)
+
+    def call(self, name=SET[0], args=None):
+        return self.eng.call(self.tid, name, dict(args or SET[1]))
+
+    def kinds(self):
+        return [e["kind"] for e in reversed(self.w.call("events", limit=100))]
+
+
+class ContinuationTests(Base):
+    def test_success_is_durable_and_ordered(self):
+        r = self.call()
+        self.assertFalse(r["isError"], r)
+        self.assertTrue(r["structuredContent"]["audit_seq"])
+        self.assertEqual(self.kinds(), ["intent", "outcome"])
+        self.assertEqual(len(self.ad.executed), 1)
+        self.assertEqual(self.ad.executed[0][1], "tdflow:1")      # undo label from the durable intent seq
+        self.assertTrue(self.w.call("verify")["ok"])
+
+    def test_concurrent_calls_and_owner_never_waits(self):
+        self.w.delay_s = 0.03                                     # slow disk
+        res = []
+        ths = [threading.Thread(target=lambda: res.append(self.call())) for _ in range(8)]
+        for t in ths:
+            t.start()
+        for t in ths:
+            t.join(30)
+        self.w.delay_s = 0
+        self.assertEqual(len(res), 8)
+        self.assertTrue(all(not r["isError"] for r in res), res)
+        self.assertLess(max(self.owner.step_ms), 25)            # far below 16 writes x 30 ms
+        k = self.kinds()
+        self.assertEqual((k.count("intent"), k.count("outcome")), (8, 8))
+
+    def test_kill_switch_between_intent_and_execute(self):
+        self.w.delay_s = 0.15
+        # Flipped while the intent is being written (a continuation is pending).
+        self.owner.on_frame.append(lambda: self.susp.__setitem__(0, bool(self.cont.pending() or self.susp[0])))
+        r = self.call()
+        self.w.delay_s = 0
+        self.assertEqual(r["structuredContent"]["code"], "SUSPENDED")
+        self.assertEqual(self.ad.executed, [])
+        ev = self.w.call("events", limit=5)
+        self.assertEqual((ev[0]["kind"], ev[0]["outcome"]), ("outcome", "aborted"))
+
+    def test_exec_gate_closed_means_not_run(self):
+        self.w.delay_s = 0.1
+        self.owner.on_frame.append(lambda: self.gate.__setitem__(0, not self.cont.pending() and self.gate[0]))
+        r = self.call()
+        self.w.delay_s = 0
+        self.assertTrue(r["isError"])
+        self.assertEqual(self.ad.executed, [])
+
+    def test_revoked_between_plan_and_execute(self):
+        self.w.delay_s = 0.1
+        snap = dict(self.idn._snap)
+        self.owner.on_frame.append(lambda: setattr(self.idn, "_snap", {} if self.cont.pending() else self.idn._snap))
+        r = self.call()
+        self.w.delay_s = 0
+        self.assertEqual(r["structuredContent"]["code"], "DENIED")
+        self.assertEqual(self.ad.executed, [])
+        self.idn._snap = snap
+
+    def test_target_changed_between_plan_and_execute(self):
+        n = [0]
+        real = self.ad.resolve
+
+        def resolve(tool, args):
+            n[0] += 1
+            r = real(tool, args)
+            if n[0] == 2:
+                r.targets[0] = r.targets[0].__class__("update", "/project1/fx/other", change="param", param="x")
+            return r
+        self.ad.resolve = resolve
+        self.assertEqual(self.call()["structuredContent"]["code"], "PRECONDITION_CHANGED")
+        self.assertEqual(self.ad.executed, [])
+
+    def test_intent_overflow_fails_closed(self):
+        self.w._q.maxsize = 1
+        self.w.delay_s = 0.2
+        self.w.submit("events")                                  # occupies the worker
+        t0 = time.monotonic()
+        while self.w.queued() and time.monotonic() - t0 < 2:
+            time.sleep(0.005)
+        self.w.submit("events")                                  # fills the queue
+        r = self.call()
+        self.w.delay_s, self.w._q.maxsize = 0, 1024
+        self.assertEqual(r["structuredContent"]["code"], "AUDIT_UNAVAILABLE")
+        self.assertEqual(self.ad.executed, [])
+        self.assertFalse(self.eng.suspended())
+
+    def test_outcome_failure_suspends_and_is_not_success(self):
+        real = self.w._store.append
+
+        def failing(kind, **kw):
+            if kind == "outcome":
+                raise AuditUnavailable("DiskError")
+            return real(kind, **kw)
+        self.w._store.append = failing
+        r = self.call()
+        self.assertEqual(r["structuredContent"]["code"], "OUTCOME_UNRECORDED")
+        self.assertTrue(self.eng.suspended())
+
+    def test_handler_timeout_cancels_before_start(self):
+        self.eng.wait_s = 0.3
+        self.w.delay_s = 0.05
+        self.owner.paused.set()
+        out = {}
+        th = threading.Thread(target=lambda: out.setdefault("r", self.call()))
+        self.owner.paused.clear()
+        # Run the plan step, then stall the 'main thread' so the execute step never comes in time.
+        self.owner.on_frame.append(lambda: self.owner.paused.set() if self.cont.pending() else None)
+        th.start()
+        th.join(10)
+        self.w.delay_s = 0
+        self.assertEqual(out["r"]["structuredContent"]["code"], "TDFLOW_TIMEOUT")
+        self.owner.on_frame.clear()
+        self.owner.paused.clear()
+        time.sleep(0.2)                                          # the late continuation must not execute
+        self.assertEqual(self.ad.executed, [])
+        ev = self.w.call("events", limit=5)
+        self.assertEqual((ev[0]["kind"], ev[0]["outcome"]), ("outcome", "aborted"))
+
+    def test_callbox_start_cancel_race(self):
+        b = CallBox()
+        self.assertTrue(b.cancel())
+        self.assertFalse(b.start())
+        b2 = CallBox()
+        self.assertTrue(b2.start())
+        self.assertFalse(b2.cancel())
+
+    def test_poll_only_on_owner(self):
+        with self.assertRaises(RuntimeError):
+            self.cont.poll()
+
+
+if __name__ == "__main__":
+    unittest.main()
