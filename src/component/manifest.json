  },
  "extension": {"dat": "TDflowMCPExt", "class": "TDflowMCPExt", "promote": true},
  "parameters": [
    {"page": "TDflowMCP", "name": "Version", "type": "Str", "label": "Version", "readonly": true, "default": "{version}", "help": "Component version and tool-surface version"},
    {"page": "TDflowMCP", "name": "Status", "type": "Str", "label": "Status", "readonly": true, "default": "Off", "help": "Controller state and error code"},
    {"page": "TDflowMCP", "name": "Statusdetail", "type": "Str", "label": "Status Detail", "readonly": true, "default": "Off. Pulse Open Setup to start the local Setup Assistant.", "help": "What is happening, including browser-launch and clipboard failures"},
    {"page": "TDflowMCP", "name": "Opensetup", "type": "Pulse", "label": "Open Setup", "help": "Run checks, start the local-only Setup Assistant and open it in your browser"},
    {"page": "TDflowMCP", "name": "Stopserver", "type": "Pulse", "label": "Stop Server", "help": "Stop the listener"},
    {"page": "TDflowMCP", "name": "Rundiagnostics", "type": "Pulse", "label": "Run Diagnostics", "help": "Re-run the compatibility checks"},
    {"page": "TDflowMCP", "name": "Setupurl", "type": "Str", "label": "Setup URL", "readonly": true, "default": "", "help": "Address of the Setup Assistant while it is running"},
    {"page": "TDflowMCP", "name": "Port", "type": "Int", "label": "Port", "default": 9480, "min": 1024, "max": 65535, "help": "Listener port. Never changed automatically; changing it stops the listener"},
    {"page": "TDflowMCP", "name": "Portstatus", "type": "Str", "label": "Port Status", "readonly": true, "default": "not checked", "help": "free / this component / in use by another process"},
    {"page": "TDflowMCP", "name": "Compatsummary", "type": "Str", "label": "Compatibility", "readonly": true, "default": "not run", "help": "pass / warn / fail / unknown counts"},
    {"page": "TDflowMCP", "name": "Tellagent", "type": "Str", "label": "Tell Your Agent", "readonly": true, "default": "Not checked yet", "help": "State of the coding-agent instructions"},
    {"page": "TDflowMCP", "name": "Copytellagent", "type": "Pulse", "label": "Copy Tell Agent", "help": "Copy the Tell Your Coding Agent text to the clipboard"},
    {"page": "TDflowMCP", "name": "Projectroot", "type": "Str", "label": "Project Root", "default": "/project1", "help": "Host project root for future agent scopes (Phase 1B); unused in 1A"},
    {"page": "TDflowMCP", "name": "Datadir", "type": "Str", "label": "Data Directory", "readonly": true, "default": "%LOCALAPPDATA%\\TDflowMCP", "help": "Where runtime state will live (nothing is stored in Phase 1A)"},
    {"page": "TDflowMCP", "name": "Loglevel", "type": "Menu", "label": "Log Level", "default": "info", "menu": ["error", "warning", "info", "debug"], "help": "Diagnostic log level"}
  ]
